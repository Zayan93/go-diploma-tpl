# Адрес и порт запуска сервиса
RUN_ADDRESS=:8080

# Адрес подключения к базе данных
DATABASE_URI=host=localhost user=postgres password=password dbname=gophermart sslmode=disable

# Адрес системы расчёта начислений
ACCRUAL_SYSTEM_ADDRESS=http://localhost:8081

# Уровень логирования
LOG_LEVEL=info

# Путь до файла с данными
FILE_STORAGE_PATH=./storage.txt

# Базовый URL для сокращённых ссылок
BASE_URL=http://localhost:8080

# Секретный ключ для JWT токенов
JWT_SECRET=your-secret-key-here
